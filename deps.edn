{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        org.clojure/core.async {:mvn/version "1.9.865"}}
 :aliases
 {:dev {:extra-paths ["dev" "test" "schemas"]
        :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}}
  ;; "schemas" carries the malli value-objects. It is NEVER on :paths — malli
  ;; does not run on the native targets, so no shipped namespace may see it.
  :test {:extra-paths ["test" "schemas"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.hive-agi/hive-test
                      {:mvn/version "0.4.0"}
                      metosin/malli {:mvn/version "0.20.1"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; Typed Clojure checker - dev-only, never in base :deps. Powers the gated
  ;; rung-3 tests: clojure -M:test:typed
  :typed {:extra-deps {org.typedclojure/typed.clj.checker {:mvn/version "1.4.0"}}}

  ;; Clojars publishing (see ../hive-build). version = the repo's VERSION file.
  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.11"}}
   :ns-default hive-build.api}

  ;; The host-free subset: clojure and nothing else. A namespace that loads
  ;; under -M:portable needs no third-party dep and no host beyond the reader,
  ;; which is the admission criterion for the JVM + cljw + cljrs target set.
  ;; hive-dsl.coerce is the one known exclusion until its JSON reader becomes
  ;; a port; lifecycle/gate/managed-channel/bounded-atom are JVM by design.
  :portable {:replace-deps {org.clojure/clojure {:mvn/version "1.12.5"}}
             :replace-paths ["src"]}}}
